  },
  {
    "type": "DOB",
    "regex": "(?i)(?:date of birth|\\bDOB\\b)[:\\s]{0,5}(\\d{1,2}[/.\\- ][0-9A-Za-z]{1,9}[/.\\- ]\\d{2,4})",
    "group": 1
  },
  {
    "type": "REFERENCE",
